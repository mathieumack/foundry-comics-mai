{
  "CosmosDb": {
    "Endpoint": "https://localhost:8081",
    "DatabaseName": "mai"
  },
  "OpenTelemetry": {
    "ServiceType": "AppInsights",
    "IgnoreErrorStatusCode": []
  },
  "StorageAccount": {
    "BlobsEndpoint": "https://replace-me.blob.core.windows.net"
  },
  "ServiceBus": {
    "JobsQueueName": "generation-jobs",
    "BookPlanJobsQueueName": "book-plan-jobs"
  },
  "Foundry": {
    "Endpoint": "https://localhost",
    "PromptModel": "MAI-Thinking-1",
    "ImageModel": "MAI-Image-2.5-Pro",
    "ImageSize": 1024,
    "MaxParallelImages": 3,
    "ImageRetryCount": 3,
    "ImageRetryBaseDelayMilliseconds": 1000
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}