@page "/"
@page "/projects/{ProjectId:guid}"
@page "/projects/{ProjectId:guid}/boards/{BoardId:guid}"
@attribute [Authorize]
@implements IDisposable
@inject GenerationApiClient GenerationClient
@inject NavigationManager Navigation
@inject NotificationService NotificationService

@code {
	[Parameter]
	public Guid? ProjectId { get; set; }

	[Parameter]
	public Guid? BoardId { get; set; }

	[Parameter]
	[SupplyParameterFromQuery(Name = "generationId")]
	public Guid? GenerationId { get; set; }
}

<PageTitle>MAI Studio</PageTitle>

<div class="project-workspace @(ProjectId is null ? null : "has-project-menu")">
	@if (ProjectId is Guid projectId)
	{
		<aside class="project-menu" aria-label="Project boards">
			<a class="back-to-projects" href="/projects">
				<RadzenIcon Icon="arrow_back" />
				All projects
			</a>
			@if (isProjectLoading)
			{
				<div class="project-menu-state" role="status">Loading project…</div>
			}
			else if (projectError is not null)
			{
				<div class="project-menu-state error" role="alert">@projectError</div>
			}
			else if (project is not null)
			{
				<h2>@project.Title</h2>
				<NavLink class="new-project-board" href="@($"/projects/{projectId:D}")" Match="NavLinkMatch.All">
					<RadzenIcon Icon="add" />
					New board
				</NavLink>
				<nav aria-label="Boards">
					@foreach (var board in projectBoards)
					{
						<NavLink class="project-board-link"
								 href="@($"/projects/{projectId:D}/boards/{board.GenerationId:D}")"
								 Match="NavLinkMatch.All">
							<span>@board.Title</span>
							<small>@board.Status</small>
						</NavLink>
					}
					@if (projectBoards.Count == 0)
					{
						<p>No boards yet.</p>
					}
				</nav>
			}
		</aside>
	}

<div class="studio-shell">
	<main class="workspace">
		<section class="control-rail" aria-label="Generation settings">
			<div class="section-heading">
				<span>01</span>
				<div>
					<h1>Storyboard</h1>
					<p>Compose panels in their reading order.</p>
				</div>
			</div>

			<details class="connection-panel" open>
				<summary>
					<span>Start from a story</span>
					<small>Let MAI-Thinking draft the whole project</small>
				</summary>
				<div class="connection-fields">
					<RadzenTextArea @bind-Value="storyDescription"
									Name="story-description"
									Placeholder="Describe your story, characters, setting, tone, and key events..."
									Rows="5"
									Disabled="EditingLocked"
									Style="width: 100%" />
					<RadzenButton Text="Scaffold project"
								  Icon="auto_fix_high"
								  ButtonStyle="ButtonStyle.Light"
								  Variant="Variant.Outlined"
								  IsBusy="isScaffolding"
								  Disabled="EditingLocked"
								  Click="@CreateScaffoldAsync"
								  Style="width: 100%" />
				</div>
			</details>

			<label for="board-title">Board title</label>
			<RadzenTextBox @bind-Value="boardTitle"
							Name="board-title"
							Placeholder="Title displayed above the panels"
							Disabled="EditingLocked"
							Style="width: 100%" />

			<label for="project-description">Project description</label>
			<RadzenTextArea @bind-Value="projectDescription"
							Name="project-description"
							Placeholder="A summary of the story and project..."
							Rows="3"
							Disabled="EditingLocked"
							Style="width: 100%" />

			<label for="context">Art direction <span>optional</span></label>
			<RadzenTextArea @bind-Value="context"
							Name="context"
							Placeholder="Shared style, characters, period, palette, and visual continuity..."
							Rows="4"
							Disabled="EditingLocked"
							Style="width: 100%" />

			<div class="panel-list-heading">
				<div>
					<strong>Panels</strong>
					<small>@panels.Count / 8</small>
				</div>
				<RadzenButton Icon="add"
							  Text="Add panel"
							  ButtonStyle="ButtonStyle.Light"
							  Variant="Variant.Flat"
							  Size="ButtonSize.Small"
							  Disabled="@(EditingLocked || panels.Count >= 8)"
							  Click="@AddPanel" />
			</div>

			<div class="panel-editor-list">
				@for (var index = 0; index < panels.Count; index++)
				{
					var panel = panels[index];
					var panelIndex = index;
					<div class="panel-editor" @key="panel.Id">
						<div class="panel-editor-toolbar">
							<span>Panel @(panelIndex + 1)</span>
							<div class="panel-actions">
								<RadzenButton Icon="arrow_upward"
												  title="Move panel up"
												  aria-label="@($"Move panel {panelIndex + 1} up")"
												  ButtonStyle="ButtonStyle.Light"
												  Variant="Variant.Flat"
												  Size="ButtonSize.Small"
												  Disabled="@(EditingLocked || panelIndex == 0)"
												  Click="@(() => MovePanel(panelIndex, -1))" />
								<RadzenButton Icon="arrow_downward"
												  title="Move panel down"
												  aria-label="@($"Move panel {panelIndex + 1} down")"
												  ButtonStyle="ButtonStyle.Light"
												  Variant="Variant.Flat"
												  Size="ButtonSize.Small"
												  Disabled="@(EditingLocked || panelIndex == panels.Count - 1)"
												  Click="@(() => MovePanel(panelIndex, 1))" />
								<RadzenButton Icon="delete_outline"
												  title="Delete panel"
												  aria-label="@($"Delete panel {panelIndex + 1}")"
												  ButtonStyle="ButtonStyle.Danger"
												  Variant="Variant.Flat"
												  Size="ButtonSize.Small"
												  Disabled="@(EditingLocked || panels.Count == 1)"
												  Click="@(() => RemovePanel(panel))" />
							</div>
						</div>
						<RadzenTextArea @bind-Value="panel.Prompt"
										Name="@($"panel-{panel.Id}")"
										Placeholder="Describe the framing, action, setting, and dialogue for this panel..."
										Rows="4"
										Disabled="EditingLocked"
										Style="width: 100%" />
						@if (characters.Count > 0)
						{
							<RadzenDropDown @bind-Value="panel.CharacterIds"
											TValue="IEnumerable<string>"
											Data="characters"
											TextProperty="Name"
											ValueProperty="Id"
											Multiple="true"
											Placeholder="Characters in this panel"
											Disabled="EditingLocked"
											Style="width: 100%" />
						}
					</div>
				}
			</div>

			<div class="inline-setting">
				<div>
					<strong>Rewrite with MAI-Thinking</strong>
					<small>Structures the prompt before generation.</small>
				</div>
				<RadzenSwitch @bind-Value="rewritePrompt" Disabled="EditingLocked" />
			</div>

			<details class="connection-panel">
				<summary>
					<span>Character references</span>
					<small>Optional identity images stored securely</small>
				</summary>
				<div class="connection-fields">
					@foreach (var character in characters)
					{
						<div class="panel-editor" @key="character.Id">
							<div class="panel-editor-toolbar">
								<strong>Character</strong>
								@if (ProjectId is null)
								{
									<RadzenButton Icon="delete_outline"
													  title="Remove character"
													  ButtonStyle="ButtonStyle.Danger"
													  Variant="Variant.Flat"
													  Size="ButtonSize.Small"
													  Disabled="EditingLocked"
													  Click="@(() => RemoveCharacter(character))" />
								}
								</div>
								<RadzenTextBox @bind-Value="character.Name"
											   Placeholder="Character name"
											   Disabled="@(EditingLocked || ProjectId is not null)"
											   Style="width: 100%" />
								@if (ProjectId is null)
								{
									<InputFile OnChange="@(args => UploadReferencesAsync(character, args))"
										   accept="image/png,image/jpeg"
										   multiple />
								}
							@if (character.References.Count > 0)
							{
								<small>@string.Join(", ", character.References.Select(reference => reference.FileName))</small>
							}
						</div>
					}
					@if (ProjectId is null)
					{
						<RadzenButton Icon="person_add"
								  Text="Add character"
								  ButtonStyle="ButtonStyle.Light"
								  Variant="Variant.Flat"
								  Disabled="EditingLocked"
								  Click="AddCharacter" />
						<p class="security-note">References are uploaded through the authenticated API and remain in private storage.</p>
					}
					else
					{
						<p class="security-note">Characters and references are shared by every board in this project.</p>
					}
				</div>
			</details>

			<div class="generation-actions">
				<RadzenButton Text="Generate board"
							  Icon="auto_awesome"
							  ButtonStyle="ButtonStyle.Primary"
							  Size="ButtonSize.Large"
							  IsBusy="isSubmitting"
							  Disabled="EditingLocked"
							  Click="@GenerateBoardAsync"
							  Style="width: 100%" />
				@if (activeGenerationId is not null && boardDataUrl is null)
				{
					<RadzenButton Text="Refresh board"
								  Icon="refresh"
								  ButtonStyle="ButtonStyle.Light"
								  Variant="Variant.Outlined"
								  IsBusy="isRefreshing"
								  Disabled="isRefreshing"
								  Click="@RefreshGenerationAsync"
								  Style="width: 100%" />
				}
			</div>

			@if (isGenerating)
			{
				<div class="generation-progress" role="status">
					<RadzenProgressBarCircular Value="@GenerationProgress" ShowValue="true" />
					<div>
						<strong>Generating board</strong>
						<span>@progressMessage</span>
					</div>
				</div>
			}
		</section>

		<section class="preview-stage" aria-label="Generation result">
			<div class="preview-toolbar">
				<div>
					<span class="eyebrow">02 / layout</span>
					<h2>Comic board</h2>
				</div>
				@if (boardDataUrl is not null)
				{
					<a class="download-link" href="@boardDataUrl" download="mai-comic-board.png">
						<RadzenIcon Icon="download" />
						Download board
					</a>
				}
			</div>

			@if (boardDataUrl is not null)
			{
				<div class="board-frame">
					<img src="@boardDataUrl" alt="Generated comic board" />
				</div>
			}
			else
			{
				<div class="board-draft @(panels.All(panel => panel.ImageDataUrl is null) ? "is-empty" : null)">
					<div class="board-title-preview">@(string.IsNullOrWhiteSpace(boardTitle) ? "Board title" : boardTitle)</div>
					<div class="board-grid">
						@for (var index = 0; index < panels.Count; index++)
						{
							var panel = panels[index];
							<div class="panel-preview @PanelStatusClass(panel.Status)" @key="panel.Id">
								@if (panel.ImageDataUrl is not null)
								{
									<img src="@panel.ImageDataUrl" alt="Generated panel @(index + 1)" />
								}
								else
								{
									<span class="panel-number">@(index + 1)</span>
									<RadzenIcon Icon="@(panel.Status == PanelUiStatus.Generating ? "hourglass_top" : "image")" />
									<small>@PanelStatusLabel(panel.Status)</small>
								}
							</div>
						}
					</div>
					@if (panels.All(panel => panel.ImageDataUrl is null) && !isGenerating)
					{
						<div class="board-empty-copy">
							<strong>Your comic board takes shape here</strong>
							<span>Each prompt creates one panel, assembled automatically in order.</span>
						</div>
					}
				</div>
			}

			@if (panels.Any(panel => panel.Status == PanelUiStatus.Error))
			{
				<div class="panel-generation-errors" role="alert">
					<strong>Some panels could not be generated</strong>
					<ul>
						@for (var index = 0; index < panels.Count; index++)
						{
							var panel = panels[index];
							if (panel.Status == PanelUiStatus.Error)
							{
								<li><span>Panel @(index + 1)</span> @(panel.Error ?? "The image could not be generated.")</li>
							}
						}
					</ul>
				</div>
			}

			@if (panels.Any(panel => !string.IsNullOrWhiteSpace(panel.EffectivePrompt)))
			{
				<details class="rewritten-prompt">
					<summary>Final prompts sent to the model</summary>
					<ol>
						@foreach (var panel in panels.Where(panel => !string.IsNullOrWhiteSpace(panel.EffectivePrompt)))
						{
							<li>@panel.EffectivePrompt</li>
						}
					</ol>
				</details>
			}
		</section>
	</main>
</div>
</div>

@code {
	private readonly List<ComicPanelDraft> panels = [new(), new(), new(), new()];
	private readonly List<CharacterDraft> characters = [];
	private readonly List<GenerationSummaryResponse> projectBoards = [];
	private CancellationTokenSource? generationCancellation;
	private Guid? activeGenerationId;
	private Guid? loadedProjectId;
	private string? storyDescription;
	private Guid? loadedGenerationId;
	private ProjectResponse? project;
	private string boardTitle = "New comic board";
	private string? projectDescription;
	private string? context;
	private string? boardDataUrl;
	private string? progressMessage;
	private string? projectError;
	private int generatedPanelCount;
	private bool rewritePrompt = true;
	private bool isGenerating;
	private bool isRefreshing;
	private bool isSubmitting;
	private bool isScaffolding;
	private bool isProjectLoading;

	private double GenerationProgress => panels.Count == 0 ? 0 : generatedPanelCount * 100d / panels.Count;
	private bool EditingLocked => isSubmitting || isGenerating || isScaffolding;

	private async Task CreateScaffoldAsync()
	{
		if (string.IsNullOrWhiteSpace(storyDescription))
		{
			Notify(NotificationSeverity.Warning, "Story description required", "Describe your story before creating a project.");
			return;
		}

		isScaffolding = true;
		try
		{
			var scaffold = await GenerationClient.CreateScaffoldAsync(
				new CreateProjectScaffoldRequest(storyDescription.Trim(), panels.Count),
				CancellationToken.None);
			boardTitle = scaffold.Title;
			projectDescription = scaffold.Description;
			context = scaffold.Context;
			panels.Clear();
			panels.AddRange(scaffold.PanelPrompts.Select(prompt => new ComicPanelDraft { Prompt = prompt }));
			activeGenerationId = null;
			boardDataUrl = null;
			Notify(NotificationSeverity.Success, "Project scaffolded", "Review and edit the generated project before creating images.");
		}
		catch (AccessTokenNotAvailableException exception)
		{
			exception.Redirect();
		}
		catch (GenerationApiException exception)
		{
			Notify(NotificationSeverity.Error, "Scaffolding failed", exception.Message);
		}
		finally
		{
			isScaffolding = false;
		}
	}

	protected override async Task OnParametersSetAsync()
	{
		var projectChanged = loadedProjectId != ProjectId;
		if (projectChanged)
		{
			loadedProjectId = ProjectId;
			project = null;
			projectBoards.Clear();
			projectError = null;
			if (ProjectId is Guid projectId)
			{
				await LoadProjectAsync(projectId);
				if (project is null)
				{
					return;
				}
			}
		}

		var requestedGenerationId = BoardId ?? GenerationId;
		if (requestedGenerationId is not Guid generationId)
		{
			if (loadedGenerationId is not null || projectChanged)
			{
				ResetBoard();
				ApplyProjectDefaults();
			}

			return;
		}

		if (ProjectId is not null && projectBoards.All(board => board.GenerationId != generationId))
		{
			projectError = "This board does not belong to the selected project.";
			return;
		}

		if (loadedGenerationId == generationId)
		{
			return;
		}

		loadedGenerationId = generationId;
		generationCancellation?.Cancel();
		generationCancellation?.Dispose();
		generationCancellation = new CancellationTokenSource();

		try
		{
			var generation = await GenerationClient.GetAsync(generationId, generationCancellation.Token);
			boardTitle = generation.Title;
			projectDescription = generation.Description;
			context = generation.Context;
			rewritePrompt = generation.RewritePrompt;
			activeGenerationId = generation.GenerationId;
			boardDataUrl = null;
			characters.Clear();
			foreach (var character in generation.Characters)
			{
				var draft = new CharacterDraft { Id = character.Id, Name = character.Name };
				draft.References.AddRange(character.References.Select(reference =>
					new UploadedReference(reference.ReferenceId, reference.FileName)));
				characters.Add(draft);
			}

			panels.Clear();
			panels.AddRange(generation.Panels
				.OrderBy(panel => panel.Number)
				.Select(panel => new ComicPanelDraft
				{
					Prompt = panel.Prompt,
					CharacterIds = panel.CharacterIds
				}));
			await ApplyGenerationAsync(generation, generationCancellation.Token);
			await HandleGenerationStatusAsync(generation, generationCancellation.Token);
		}
		catch (AccessTokenNotAvailableException exception)
		{
			exception.Redirect();
		}
		catch (GenerationApiException exception)
		{
			Notify(NotificationSeverity.Error, "Board could not be opened", exception.Message);
		}
		catch (OperationCanceledException)
		{
		}
	}

	private async Task LoadProjectAsync(Guid projectId)
	{
		isProjectLoading = true;
		try
		{
			project = await GenerationClient.GetProjectAsync(projectId, CancellationToken.None);
			projectBoards.AddRange(await GenerationClient.ListBoardsAsync(projectId, CancellationToken.None));
		}
		catch (AccessTokenNotAvailableException exception)
		{
			exception.Redirect();
		}
		catch (GenerationApiException exception)
		{
			project = null;
			projectError = exception.Message;
		}
		finally
		{
			isProjectLoading = false;
		}
	}

	private void ApplyProjectDefaults()
	{
		if (project is null)
		{
			return;
		}

		context = project.Context;
		characters.Clear();
		foreach (var character in project.Characters)
		{
			var draft = new CharacterDraft { Id = character.CharacterId, Name = character.Name };
			draft.References.AddRange(character.References.Select(reference =>
				new UploadedReference(reference.ReferenceId, reference.FileName)));
			characters.Add(draft);
		}
	}

	private void ResetBoard()
	{
		generationCancellation?.Cancel();
		generationCancellation?.Dispose();
		generationCancellation = null;
		activeGenerationId = null;
		loadedGenerationId = null;
		boardTitle = "New comic board";
		projectDescription = null;
		context = null;
		boardDataUrl = null;
		progressMessage = null;
		generatedPanelCount = 0;
		rewritePrompt = true;
		isGenerating = false;
		isRefreshing = false;
		isSubmitting = false;
		characters.Clear();
		panels.Clear();
		panels.AddRange([new(), new(), new(), new()]);
	}

	private async Task GenerateBoardAsync()
	{
		if (!ValidateBoard())
		{
			return;
		}

		generationCancellation?.Cancel();
		generationCancellation?.Dispose();
		generationCancellation = new CancellationTokenSource();
		boardDataUrl = null;
		generatedPanelCount = 0;
		isGenerating = true;
		isSubmitting = true;
		activeGenerationId = null;

		try
		{
			foreach (var panel in panels)
			{
				panel.Status = PanelUiStatus.Pending;
				panel.ImageDataUrl = null;
				panel.EffectivePrompt = null;
				panel.Error = null;
			}

			progressMessage = "Submitting generation";
			var panelRequests = panels.Select(panel => new PanelRequest(
				panel.Prompt.Trim(),
				panel.CharacterIds.ToArray())).ToArray();
			GenerationResponse generation;
			if (ProjectId is Guid projectId && project is not null)
			{
				if (!string.Equals(project.Context, context?.Trim(), StringComparison.Ordinal))
				{
					project = await GenerationClient.UpdateProjectAsync(
						projectId,
						new CreateProjectRequest(project.Title, context?.Trim()),
						generationCancellation.Token);
				}

				generation = await GenerationClient.CreateBoardAsync(
					projectId,
					new CreateBoardRequest(
						boardTitle.Trim(),
						projectDescription?.Trim(),
						rewritePrompt,
						panelRequests),
					generationCancellation.Token);
				projectBoards.Insert(0, new GenerationSummaryResponse(
					generation.GenerationId,
					generation.Title,
					generation.CreatedAt,
					generation.Status,
					null));
				loadedGenerationId = generation.GenerationId;
			}
			else
			{
				var request = new CreateGenerationRequest(
					boardTitle.Trim(),
					projectDescription?.Trim(),
					context?.Trim(),
					rewritePrompt,
					panelRequests,
					characters.Select(character => new CharacterRequest(
						character.Id,
						character.Name.Trim(),
						character.References.Select(reference => reference.ReferenceId).ToArray())).ToArray());
				generation = await GenerationClient.CreateAsync(request, generationCancellation.Token);
			}

			activeGenerationId = generation.GenerationId;
			await ApplyGenerationAsync(generation, generationCancellation.Token);
			await HandleGenerationStatusAsync(generation, generationCancellation.Token);
			if (ProjectId is Guid activeProjectId)
			{
				Navigation.NavigateTo($"/projects/{activeProjectId:D}/boards/{generation.GenerationId:D}");
			}
			if (generation.Status is GenerationStatus.Pending or GenerationStatus.Processing)
			{
				Notify(NotificationSeverity.Info, "Generation queued", "Use Refresh board to retrieve the latest panels and status.");
			}
		}
		catch (AccessTokenNotAvailableException exception)
		{
			exception.Redirect();
		}
		catch (GenerationApiException exception)
		{
			isGenerating = false;
			Notify(NotificationSeverity.Error, "Generation failed", exception.Message);
		}
		catch (OperationCanceledException)
		{
			isGenerating = false;
		}
		finally
		{
			isSubmitting = false;
		}
	}

	private async Task RefreshGenerationAsync()
	{
		if (activeGenerationId is not Guid generationId || isRefreshing)
		{
			return;
		}

		isRefreshing = true;
		try
		{
			var generation = await GenerationClient.GetAsync(generationId, generationCancellation?.Token ?? CancellationToken.None);
			await ApplyGenerationAsync(generation, generationCancellation?.Token ?? CancellationToken.None);
			await HandleGenerationStatusAsync(generation, generationCancellation?.Token ?? CancellationToken.None);
		}
		catch (AccessTokenNotAvailableException exception)
		{
			exception.Redirect();
		}
		catch (GenerationApiException exception)
		{
			Notify(NotificationSeverity.Error, "Refresh failed", exception.Message);
		}
		catch (OperationCanceledException)
		{
		}
		finally
		{
			isRefreshing = false;
		}
	}

	private async Task HandleGenerationStatusAsync(GenerationResponse generation, CancellationToken cancellationToken)
	{
		isGenerating = generation.Status is GenerationStatus.Pending or GenerationStatus.Processing;
		if (generation.Status == GenerationStatus.Completed)
		{
			if (generation.BoardUri is not null && boardDataUrl is null)
			{
				boardDataUrl = await GenerationClient.DownloadDataUrlAsync(generation.BoardUri, cancellationToken);
			}

			var failedPanelCount = generation.Panels.Count(panel => panel.Status == PanelGenerationStatus.Failed);
			if (failedPanelCount > 0)
			{
				Notify(
					NotificationSeverity.Warning,
					"Board generated with missing panels",
					$"{failedPanelCount} panel(s) were blocked by content safety. Review the details below the board.");
			}
			else
			{
				Notify(NotificationSeverity.Success, "Board ready", "Your comic board was generated successfully.");
			}
		}
		else if (generation.Status == GenerationStatus.Failed)
		{
			Notify(NotificationSeverity.Error, "Generation failed", generation.Error ?? "The API could not complete the board.");
		}
		else if (generation.Status == GenerationStatus.Canceled)
		{
			Notify(NotificationSeverity.Warning, "Generation canceled", "The board generation was canceled by the worker.");
		}
	}

	private bool ValidateBoard()
	{
		if (string.IsNullOrWhiteSpace(boardTitle))
		{
			Notify(NotificationSeverity.Warning, "Board title required", "Enter a title before starting generation.");
			return false;
		}

		var emptyPanelIndex = panels.FindIndex(panel => string.IsNullOrWhiteSpace(panel.Prompt));
		if (emptyPanelIndex >= 0)
		{
			Notify(NotificationSeverity.Warning, "Panel prompt required", $"Describe panel {emptyPanelIndex + 1} before starting generation.");
			return false;
		}

		var invalidCharacter = ProjectId is null
			? characters.FirstOrDefault(character =>
				string.IsNullOrWhiteSpace(character.Name) || character.References.Count == 0)
			: null;
		if (invalidCharacter is not null)
		{
			Notify(NotificationSeverity.Warning, "Character incomplete", "Every character needs a name and at least one reference image.");
			return false;
		}

		return true;
	}

	private void AddPanel()
	{
		if (panels.Count < 8)
		{
			panels.Add(new ComicPanelDraft());
			boardDataUrl = null;
		}
	}

	private void RemovePanel(ComicPanelDraft panel)
	{
		if (panels.Count > 1)
		{
			panels.Remove(panel);
			boardDataUrl = null;
		}
	}

	private void MovePanel(int index, int offset)
	{
		var destination = index + offset;
		if (destination < 0 || destination >= panels.Count)
		{
			return;
		}

		(panels[index], panels[destination]) = (panels[destination], panels[index]);
		boardDataUrl = null;
	}

	private void AddCharacter() => characters.Add(new CharacterDraft());

	private void RemoveCharacter(CharacterDraft character)
	{
		characters.Remove(character);
		foreach (var panel in panels)
		{
			panel.CharacterIds = panel.CharacterIds.Where(id => id != character.Id).ToArray();
		}
	}

	private async Task UploadReferencesAsync(CharacterDraft character, InputFileChangeEventArgs args)
	{
		try
		{
			foreach (var file in args.GetMultipleFiles(4))
			{
				var uploaded = await GenerationClient.UploadReferenceAsync(file, CancellationToken.None);
				character.References.Add(new UploadedReference(uploaded.ReferenceId, uploaded.FileName));
			}
			StateHasChanged();
		}
		catch (AccessTokenNotAvailableException exception)
		{
			exception.Redirect();
		}
		catch (Exception exception)
		{
			Notify(NotificationSeverity.Error, "Reference upload failed", exception.Message);
		}
	}

	private async Task ApplyGenerationAsync(GenerationResponse generation, CancellationToken cancellationToken)
	{
		generatedPanelCount = generation.CompletedPanelCount;
		progressMessage = generation.Status switch
		{
			GenerationStatus.Pending => "Waiting for an available generation worker",
			GenerationStatus.Processing => $"Generated {generation.CompletedPanelCount} of {generation.PanelCount} panels",
			GenerationStatus.Completed => "Board assembled",
			GenerationStatus.Failed => "Generation failed",
			GenerationStatus.Canceled => "Generation canceled",
			_ => "Generating board"
		};

		foreach (var panelStatus in generation.Panels)
		{
			var panel = panels[panelStatus.Number - 1];
			panel.Status = panelStatus.Status switch
			{
				PanelGenerationStatus.Processing => PanelUiStatus.Generating,
				PanelGenerationStatus.Completed => PanelUiStatus.Ready,
				PanelGenerationStatus.Failed => PanelUiStatus.Error,
				_ => PanelUiStatus.Pending
			};
			panel.EffectivePrompt = panelStatus.EffectivePrompt;
			panel.Error = panelStatus.Error;
			if (panel.ImageDataUrl is null && panelStatus.ImageUri is not null)
			{
				panel.ImageDataUrl = await GenerationClient.DownloadDataUrlAsync(panelStatus.ImageUri, cancellationToken);
			}
		}
	}

	private void Notify(NotificationSeverity severity, string summary, string detail)
	{
		NotificationService.Notify(new NotificationMessage
		{
			Severity = severity,
			Summary = summary,
			Detail = detail,
			Duration = 6000
		});
	}

	private static string PanelStatusClass(PanelUiStatus status) => status switch
	{
		PanelUiStatus.Generating => "is-generating",
		PanelUiStatus.Ready => "is-ready",
		PanelUiStatus.Error => "has-error",
		_ => string.Empty
	};

	private static string PanelStatusLabel(PanelUiStatus status) => status switch
	{
		PanelUiStatus.Generating => "Generating...",
		PanelUiStatus.Ready => "Ready",
		PanelUiStatus.Error => "Failed",
		_ => "Pending"
	};

	public void Dispose()
	{
		generationCancellation?.Cancel();
		generationCancellation?.Dispose();
	}
}
