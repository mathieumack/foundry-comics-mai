@page "/boards/new"
@page "/projects/{ProjectId:guid}"
@page "/projects/{ProjectId:guid}/boards/{BoardId:guid}"
@attribute [Authorize]

<PageTitle>@(project?.Title ?? "Atelier BD") · MAI Studio</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="BeforeNavigationAsync" />
<main>
    <header class="page-heading workspace-heading">
        <div><a class="link-btn" href="/projects">← Mes histoires</a><h1>@(project?.Title ?? "Votre prochaine aventure")</h1><p>Votre idée, vos choix. Une planche à la fois.</p></div>
        <div class="header-actions">
            <span class="status @(isGenerating ? "working" : "")">@(isGenerating ? "Génération en cours" : HasUnsavedChanges ? "Brouillon non sauvegardé" : activeGenerationId is not null ? "Version sauvegardée" : "Nouvelle planche")</span>
            @if (boardDataUrl is not null)
            {
                <a class="btn" href="@boardDataUrl" download="mai-comic-board.png"><RadzenIcon Icon="download" />Télécharger le PNG</a>
            }
        </div>
    </header>
    @if (projectError is not null) { <div class="error" role="alert">@projectError</div> }
    @if (workspaceError is not null) { <div class="error" role="alert">@workspaceError</div> }
    @if (isProjectLoading || isBoardLoading)
    {
        <div class="loading-state" role="status"><RadzenProgressBarCircular ShowValue="false" /><span>Ouverture de votre atelier…</span></div>
    }
    else if (projectError is null)
    {
        <div class="workspace-layout">
            <aside class="project-menu" aria-label="Planches du projet">
                <span class="eyebrow">Le fil de l'histoire</span>
                <h2>@(project?.Title ?? "Planche libre")</h2>
                @if (ProjectId is Guid projectId)
                {
                    <NavLink class="board-link" href="@($"/projects/{projectId:D}")" Match="NavLinkMatch.All"><RadzenIcon Icon="add" />Nouvelle planche</NavLink>
                    <nav aria-label="Planches">
                        @foreach (var board in projectBoards)
                        {
                            <NavLink class="board-link" href="@($"/projects/{projectId:D}/boards/{board.GenerationId:D}")" Match="NavLinkMatch.All"><span>@board.Title</span><small>@StatusLabel(board.Status)</small></NavLink>
                        }
                    </nav>
                    @if (projectBoards.Count == 0) { <p class="hint">Votre première planche vous attend.</p> }
                }
                else { <p class="hint">Composez une planche libre ou <a href="/new">créez une histoire</a> pour partager vos personnages entre plusieurs planches.</p> }
            </aside>
            <div class="studio-workspace">
                <div class="segments studio-tabs" role="group" aria-label="Étapes de la planche">
                    <button class="segment" aria-pressed="@(activeTab == StudioTab.Scenes ? "true" : "false")" @onclick="() => activeTab = StudioTab.Scenes">1. Les scènes</button>
                    <button class="segment" aria-pressed="@(activeTab == StudioTab.Characters ? "true" : "false")" @onclick="() => activeTab = StudioTab.Characters">2. Les personnages</button>
                    <button class="segment" aria-pressed="@(activeTab == StudioTab.Preview ? "true" : "false")" @onclick="() => activeTab = StudioTab.Preview">3. La planche</button>
                </div>
                @if (activeTab == StudioTab.Characters)
                {
                    <section class="surface">
                        <span class="eyebrow">Le casting de votre histoire</span><h2>Des héros qu'on reconnaît.</h2>
                        <p class="hint">Les personnages et références sont communs à toutes les planches du projet. Leur nom et leurs images sont sauvegardés avec les boutons ci-dessous.</p>
                        <div class="character-grid">
                            @foreach (var character in characters)
                            {
                                <article class="character-card" @key="character.Id">
                                    <label class="field" for="@($"character-{character.Id}")">Nom du personnage</label>
                                    <input class="text" id="@($"character-{character.Id}")" @bind="character.Name" @bind:event="oninput" disabled="@EditingLocked" maxlength="200" />
                                    <div class="row-actions" style="margin-top:12px">
                                        @if (ProjectId is not null) { <button class="btn" @onclick="() => SaveCharacterAsync(character)" disabled="@EditingLocked">Enregistrer le nom</button> }
                                        <button class="btn quiet" @onclick="() => RemoveCharacterAsync(character)" disabled="@EditingLocked">Retirer</button>
                                    </div>
                                    <label class="field" for="@($"reference-{character.Id}")">Images de référence (PNG ou JPEG)</label>
                                    <InputFile id="@($"reference-{character.Id}")" OnChange="args => UploadReferencesAsync(character, args)" accept="image/png,image/jpeg" multiple disabled="@EditingLocked" />
                                    <p class="hint">4 fichiers par envoi · 10 Mo maximum par image. Envoi privé via l'API.</p>
                                    <ul class="reference-list">@foreach (var reference in character.References) { <li>@reference.FileName</li> }</ul>
                                </article>
                            }
                        </div>
                        <label class="field" for="new-character">Un nouveau personnage</label>
                        <div class="row-actions"><input class="text" id="new-character" @bind="newCharacterName" placeholder="Son petit nom" maxlength="200" disabled="@EditingLocked" style="max-width:240px" /><button class="btn" @onclick="AddCharacterAsync" disabled="@EditingLocked"><RadzenIcon Icon="person_add" />Ajouter</button></div>
                        @if (isCharacterSaving) { <p role="status" class="hint">Enregistrement du personnage…</p> }
                    </section>
                }
                else
                {
                    <div class="editor-layout">
                        <section class="surface">
                            @if (activeTab == StudioTab.Scenes)
                            {
                                <span class="eyebrow">Le storyboard</span><h2>Chaque case raconte quelque chose.</h2>
                                <details open="@(panels.All(p => string.IsNullOrWhiteSpace(p.Prompt)))">
                                    <summary>Partir d'une idée</summary>
                                    <label class="field" for="story-description">Racontez l'aventure</label>
                                    <textarea class="text" id="story-description" @bind="storyDescription" rows="4" disabled="@EditingLocked" placeholder="Personnages, lieu, ton, rebondissements…"></textarea>
                                    <button class="btn" style="margin-top:12px" @onclick="CreateScaffoldAsync" disabled="@EditingLocked"><RadzenIcon Icon="auto_fix_high" />@(isScaffolding ? "MAI imagine vos scènes…" : "Proposer mes scènes")</button>
                                </details>
                                <label class="field" for="board-title">Titre de la planche</label><input class="text" id="board-title" @bind="boardTitle" @bind:event="oninput" disabled="@EditingLocked" />
                                <div class="panel-picks" role="group" aria-label="Choisir une case">
                                    @for (var index = 0; index < panels.Count; index++)
                                    {
                                        var panelIndex = index;
                                        <button class="panel-pick" aria-pressed="@(selectedPanel == panelIndex ? "true" : "false")" @onclick="() => selectedPanel = panelIndex">@((index + 1).ToString("D2"))</button>
                                    }
                                </div>
                                @if (panels.Count > 0)
                                {
                                    var panel = panels[selectedPanel];
                                    <label class="field" for="panel-prompt">Que se passe-t-il dans la case @(selectedPanel + 1) ?</label>
                                    <textarea @key="panel.Id" class="text" id="panel-prompt" @bind="panel.Prompt" @bind:event="oninput" rows="5" disabled="@EditingLocked" placeholder="Cadrage, action, décor, dialogue…"></textarea>
                                    @if (characters.Count > 0)
                                    {
                                        <label class="field" for="panel-characters">Personnages présents</label>
                                        <RadzenDropDown @bind-Value="panel.CharacterIds" TValue="IEnumerable<string>" Data="characters" TextProperty="Name" ValueProperty="Id" Multiple="true" Name="panel-characters" aria-label="Personnages présents dans la case" Disabled="EditingLocked" Style="width:100%" />
                                    }
                                    <div class="row-actions" style="margin-top:16px"><button class="btn quiet" disabled="@(EditingLocked || selectedPanel == 0)" @onclick="() => MovePanel(-1)">← Avant</button><button class="btn quiet" disabled="@(EditingLocked || selectedPanel == panels.Count - 1)" @onclick="() => MovePanel(1)">Après →</button></div>
                                }
                                <details><summary>Direction artistique & réglages</summary>
                                    <label class="field" for="description">Résumé du projet</label><textarea class="text" id="description" @bind="projectDescription" rows="3" disabled="@EditingLocked"></textarea>
                                    <label class="field" for="context">Ambiance commune</label><textarea class="text" id="context" @bind="context" rows="3" disabled="@EditingLocked"></textarea>
                                    <label class="field" for="board-template">Mise en page</label>
                                    <select class="text" id="board-template" value="@selectedTemplate" @onchange="ChangeTemplateAsync" disabled="@EditingLocked"><option value="@BoardTemplate.Standard">Classique · 6 cases</option><option value="@BoardTemplate.Storyline">Strip · 3 cases</option><option value="@BoardTemplate.Dynamic1">Dynamique · 5 cases</option><option value="@BoardTemplate.Dynamic2">Ouverture cinéma · 5 cases</option></select>
                                    <label class="checkline"><input type="checkbox" @bind="rewritePrompt" disabled="@EditingLocked" />Enrichir les consignes avec MAI</label>
                                </details>
                            }
                            else
                            {
                                <span class="eyebrow">Le grand aperçu</span><h2>@(boardDataUrl is not null ? "Votre aventure prend forme." : "Tout commence par vos scènes.")</h2>
                                <p class="hint">Les images apparaissent case par case. Vous pouvez revenir aux scènes pour préparer une nouvelle version.</p>
                            }
                            <div class="generation-box">
                                @if (isGenerating)
                                {
                                    <div role="status"><strong>Votre planche prend vie…</strong><p class="hint">@progressMessage</p><progress value="@generatedPanelCount" max="@panels.Count" aria-label="Cases illustrées"></progress><p class="hint">Vous pouvez quitter l'atelier et retrouver cette planche dans votre projet.</p></div>
                                }
                                else
                                {
                                    <strong>@(activeGenerationId is null ? "Prêt pour le premier coup de crayon ?" : "Envie d'une nouvelle version ?")</strong>
                                    <button class="btn primary" @onclick="GenerateBoardAsync" disabled="@EditingLocked"><RadzenIcon Icon="auto_awesome" />@(isSubmitting ? "Envoi…" : activeGenerationId is null ? "Illustrer ma planche" : "Générer une nouvelle version")</button>
                                    <p class="hint">Les scènes sont sauvegardées au lancement. Une nouvelle génération ne remplace pas les versions précédentes du projet.</p>
                                }
                                @if (activeGenerationId is not null)
                                {
                                    <button class="btn quiet" @onclick="RefreshGenerationAsync" disabled="@isRefreshing"><RadzenIcon Icon="refresh" />@(isRefreshing ? "Actualisation…" : "Actualiser la planche")</button>
                                }
                            </div>
                        </section>
                        <section aria-label="Aperçu de la planche">
                            @if (boardDataUrl is not null && activeTab == StudioTab.Preview)
                            {
                                <div class="board-frame"><img src="@boardDataUrl" alt="Planche de bande dessinée générée" /></div>
                            }
                            else
                            {
                                <div class="board-draft"><div class="board-title-preview">@boardTitle</div><div class="board-grid" style="@BoardGridStyle">
                                    @for (var index = 0; index < panels.Count; index++)
                                    {
                                        var panelIndex = index;
                                        var panel = panels[index];
                                        <button class="panel-preview @PanelStatusClass(panel.Status)" style="@PanelSlotStyle(index)" aria-label="@($"Modifier la case {index + 1} : {PanelStatusLabel(panel.Status)}")" aria-pressed="@(selectedPanel == index ? "true" : "false")" @onclick="() => SelectPanel(panelIndex)">
                                            <span class="panel-number">@(index + 1)</span>
                                            @if (panel.ImageDataUrl is not null) { <img src="@panel.ImageDataUrl" alt="@($"Case {index + 1} générée")" /> }
                                            else { <RadzenIcon Icon="@(panel.Status == PanelUiStatus.Generating ? "hourglass_top" : "image")" /><small>@PanelStatusLabel(panel.Status)</small> }
                                        </button>
                                    }
                                </div></div>
                            }
                            <p class="hint" style="text-align:center">APERÇU · @panels.Count cases · @(boardDataUrl is not null && activeTab == StudioTab.Preview ? "Revenez aux scènes pour préparer une nouvelle version." : "Cliquez sur une case pour la modifier.")</p>
                            @if (panels.Any(panel => panel.Status == PanelUiStatus.Error))
                            {
                                <div class="error" role="alert"><strong>Certaines images n'ont pas pu être créées.</strong><ul>
                                    @for (var index = 0; index < panels.Count; index++) { if (panels[index].Status == PanelUiStatus.Error) { <li>Case @(index + 1) : @panels[index].Error</li> } }
                                </ul><p>Les autres cases restent disponibles. Modifiez les scènes concernées puis générez une nouvelle version de la planche.</p></div>
                            }
                            @if (panels.Any(p => !string.IsNullOrWhiteSpace(p.EffectivePrompt)))
                            {
                                <details><summary>Consignes finales envoyées au modèle</summary><ol>@foreach (var panel in panels) { <li>@panel.EffectivePrompt</li> }</ol></details>
                            }
                        </section>
                    </div>
                }
            </div>
        </div>
    }
</main>
