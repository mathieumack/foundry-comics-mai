@page "/projects/{ProjectId:guid}/book"
@attribute [Authorize]
@implements IDisposable
@inject GenerationApiClient GenerationClient
@inject DialogService DialogService

<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges"
                OnBeforeInternalNavigation="ConfirmNavigationAsync" />

<PageTitle>@(project?.Title ?? "Livre illustré")</PageTitle>

<main class="book-shell">
    <a class="back-link" href="/projects">← Mes histoires</a>

    @if (isLoading)
    {
        <div class="empty-state" role="status">Ouverture de votre livre…</div>
    }
    else if (error is not null && project is null)
    {
        <div class="error" role="alert">@error</div>
    }
    else if (project is not null)
    {
        <header class="page-heading workspace-heading">
            <div>
                <span class="eyebrow">Livre illustré</span>
                <h1>@project.Title</h1>
                <p class="muted">Un plan d’abord. Puis l’aventure, chapitre après chapitre.</p>
            </div>
            <div class="header-actions">
                <div class="field chapter-count-field">
                    <label for="chapter-count">Nombre de chapitres</label>
                    <input id="chapter-count"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]+"
                           required
                           value="@chapterCountText"
                           @oninput="UpdateChapterCount"
                           disabled="@isBusy"
                           aria-invalid="@(IsChapterCountValid ? "false" : "true")"
                           aria-describedby="chapter-count-hint" />
                    <span id="chapter-count-hint" class="@(IsChapterCountValid ? "hint" : "error")">
                        @(IsChapterCountValid ? "De 1 à 30 chapitres." : "Saisissez un nombre entier de 1 à 30.")
                    </span>
                </div>
                <RadzenButton Text="@(chapters.Count == 0 ? "Créer le plan" : "Recréer le plan")"
                              Icon="auto_fix_high"
                              class="btn primary"
                              ButtonStyle="ButtonStyle.Primary"
                              IsBusy="isPlanning"
                              Disabled="isBusy || !IsChapterCountValid"
                              Click="@GeneratePlanAsync" />
            </div>
        </header>

        @if (error is not null)
        {
            <div class="error" role="alert">@error</div>
        }

        @if (planError is not null)
        {
            <div class="error" role="alert">Le plan n’a pas pu être créé : @planError</div>
        }

        @if (HasUnsavedChanges)
        {
            <p class="hint" role="status">Modifications non enregistrées. Pensez à les conserver avant de quitter.</p>
        }
        else if (chapters.Count > 0)
        {
            <p class="hint" role="status">Toutes les modifications sont enregistrées.</p>
        }

        @if (isPlanning)
        {
            <div class="surface plan-progress" role="status">
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
                <p>Votre plan de chapitres se prépare. Vous pourrez revenir ici plus tard.</p>
            </div>
        }

        @if (chapters.Count == 0)
        {
            <section class="surface empty-state empty-plan">
                <RadzenIcon Icon="menu_book" />
                <h2>Donnez une structure à votre histoire</h2>
                <p class="muted">MAI-Thinking proposera des titres, les grandes étapes du récit et des repères de continuité.</p>
                @if (planError is null)
                {
                    <p class="hint">Choisissez le nombre de chapitres, puis créez votre plan.</p>
                }
            </section>
        }
        else
        {
            <div class="book-actions">
                <span class="hint">@chapters.Count chapitres · sélectionnez-en un pour vous concentrer sur son contenu</span>
                <div class="header-actions">
                    <RadzenButton Text="Garder mes modifications"
                                  Icon="save"
                                  class="btn quiet"
                                  ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Outlined"
                                  IsBusy="isSaving"
                                  Disabled="isBusy || !HasUnsavedChanges"
                                  Click="@SaveAsync" />
                    <RadzenButton Text="Générer les éléments manquants"
                                  Icon="auto_awesome"
                                  class="btn primary"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled="isBusy"
                                  Click="@GenerateRemainingAsync" />
                </div>
            </div>

            <div class="book-layout">
                <aside class="surface chapter-list" aria-label="Navigation des chapitres">
                    <span class="eyebrow">Le chemin de l’histoire</span>
                    <p class="hint">@chapters.Count chapitres au programme</p>
                    <nav aria-label="Choisir un chapitre">
                        @foreach (var chapter in chapters)
                        {
                            <button @key="chapter.Id"
                                    type="button"
                                    class="chapter-nav-item @(chapter.Id == selectedChapterId ? "is-current" : string.Empty)"
                                    aria-pressed="@(chapter.Id == selectedChapterId ? "true" : "false")"
                                    @onclick="() => SelectChapter(chapter.Id)">
                                <span class="chapter-nav-number">@chapter.Number.ToString("D2")</span>
                                <span class="chapter-nav-title">@chapter.Title</span>
                                @if (chapter.ProseStatus == GenerationStatus.Completed)
                                {
                                    <span class="status ready">Texte prêt</span>
                                }
                                else
                                {
                                    <span class="status">À écrire</span>
                                }
                            </button>
                        }
                    </nav>
                </aside>

                @if (SelectedChapter is { } chapterDraft)
                {
                    <article class="surface chapter-editor" @key="chapterDraft.Id" aria-labelledby="active-chapter-title">
                        <div class="section-heading">
                            <div>
                                <span class="eyebrow">Chapitre @chapterDraft.Number</span>
                                <h2 id="active-chapter-title">@chapterDraft.Title</h2>
                            </div>
                            <div class="chapter-statuses" aria-label="État du chapitre">
                                <span class="@StatusClass(chapterDraft.ProseStatus)">Texte : @StatusLabel(chapterDraft.ProseStatus)</span>
                                <span class="@StatusClass(chapterDraft.ImageStatus)">Image : @StatusLabel(chapterDraft.ImageStatus)</span>
                            </div>
                        </div>

                        <div class="field">
                            <label for="chapter-title">Titre du chapitre</label>
                            <RadzenTextBox id="chapter-title"
                                           @bind-Value="chapterDraft.Title"
                                           Placeholder="Le titre de ce chapitre"
                                           Disabled="isBusy"
                                           Style="width: 100%" />
                        </div>
                        <div class="field">
                            <label for="chapter-summary">Ce qui se passe dans ce chapitre</label>
                            <RadzenTextArea id="chapter-summary"
                                            @bind-Value="chapterDraft.Summary"
                                            Rows="4"
                                            Disabled="isBusy"
                                            Style="width: 100%" />
                        </div>

                        <details class="continuity-details">
                            <summary>Personnages et continuité</summary>
                            <div class="field">
                                <label for="chapter-events">Évolution des personnages</label>
                                <RadzenTextArea id="chapter-events"
                                                @bind-Value="chapterDraft.CharacterEvents"
                                                Rows="3"
                                                Disabled="isBusy"
                                                Style="width: 100%" />
                            </div>
                            <div class="field">
                                <label for="chapter-continuity">Détails à ne pas oublier</label>
                                <RadzenTextArea id="chapter-continuity"
                                                @bind-Value="chapterDraft.Continuity"
                                                Rows="3"
                                                Disabled="isBusy"
                                                Style="width: 100%" />
                            </div>
                        </details>

                        <section class="chapter-section" aria-labelledby="prose-heading">
                            <div class="section-heading">
                                <h3 id="prose-heading">Le récit</h3>
                                <span class="@StatusClass(chapterDraft.ProseStatus)">@StatusLabel(chapterDraft.ProseStatus)</span>
                            </div>
                            <div class="field">
                                <label for="chapter-prose">Votre texte, toujours modifiable</label>
                                <RadzenTextArea id="chapter-prose"
                                                @bind-Value="chapterDraft.Prose"
                                                Rows="12"
                                                Placeholder="Le récit apparaîtra ici. Vous pouvez aussi écrire directement."
                                                Disabled="isBusy"
                                                Style="width: 100%" />
                            </div>
                            @if (chapterDraft.ProseError is not null)
                            {
                                <p class="error" role="alert">@chapterDraft.ProseError</p>
                            }
                            <RadzenButton Text="@(string.IsNullOrWhiteSpace(chapterDraft.Prose) ? "Écrire ce chapitre" : "Réécrire le texte")"
                                          Icon="edit_note"
                                          class="btn primary"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Disabled="isBusy"
                                          Click="@(() => GenerateProseAsync(chapterDraft.Id))" />
                        </section>

                        <section class="chapter-section" aria-labelledby="illustration-heading">
                            <div class="section-heading">
                                <h3 id="illustration-heading">L’illustration</h3>
                                <span class="@StatusClass(chapterDraft.ImageStatus)">@StatusLabel(chapterDraft.ImageStatus)</span>
                            </div>
                            <div class="field">
                                <label for="chapter-image-prompt">La scène à illustrer <span class="muted">(facultatif)</span></label>
                                <RadzenTextArea id="chapter-image-prompt"
                                                @bind-Value="chapterDraft.ImagePrompt"
                                                Rows="3"
                                                Placeholder="Laissez vide pour partir du résumé du chapitre."
                                                Disabled="isBusy"
                                                Style="width: 100%" />
                            </div>
                            @if (chapterDraft.ImageError is not null)
                            {
                                <p class="error" role="alert">@chapterDraft.ImageError</p>
                            }
                            @if (chapterDraft.ImageLoadError is not null)
                            {
                                <p class="error" role="alert">L’illustration n’a pas pu être affichée : @chapterDraft.ImageLoadError</p>
                            }
                            @if (chapterDraft.ImageDataUrl is not null)
                            {
                                <img class="chapter-image"
                                     src="@chapterDraft.ImageDataUrl"
                                     alt="@($"Illustration du chapitre {chapterDraft.Number}")" />
                            }
                            else if (chapterDraft.ImageStatus == GenerationStatus.Completed)
                            {
                                <p class="hint" role="status">Chargement de l’illustration…</p>
                            }
                            else
                            {
                                <p class="hint">Le texte et l’image se créent séparément. Une illustration sera associée à ce chapitre.</p>
                            }
                            <RadzenButton Text="@(chapterDraft.ImageStatus == GenerationStatus.Completed ? "Recréer l’illustration" : "Illustrer ce chapitre")"
                                          Icon="image"
                                          class="btn quiet"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Outlined"
                                          Disabled="isBusy"
                                          Click="@(() => GenerateImageAsync(chapterDraft.Id))" />
                        </section>
                    </article>
                }
            </div>
        }
    }
</main>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private readonly CancellationTokenSource cancellation = new();
    private readonly List<ChapterDraft> chapters = [];
    private readonly Dictionary<string, ChapterValues> savedDrafts = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> activeImageLoads = new(StringComparer.Ordinal);
    private ProjectResponse? project;
    private string? error;
    private string? planError;
    private string? selectedChapterId;
    private bool isPlanGenerationActive;
    private string chapterCountText = "8";
    private bool IsChapterCountValid => TryGetChapterCount(out _);
    private bool isLoading = true;
    private bool isPlanning;
    private bool isSaving;
    private bool isGenerating;
    private bool isBusy => isPlanning || isSaving || isGenerating;
    private bool HasUnsavedChanges => chapters.Any(HasUnsavedChangesFor);
    private ChapterDraft? SelectedChapter => chapters.SingleOrDefault(chapter => chapter.Id == selectedChapterId);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        error = null;
        try
        {
            project = await GenerationClient.GetProjectAsync(ProjectId, cancellation.Token);
            if (project.Type != ProjectType.Book)
            {
                error = "Ce projet n’est pas un livre illustré.";
                return;
            }

            ApplyPlan(await GenerationClient.GetBookPlanAsync(ProjectId, cancellation.Token), markSaved: true);
            if (isPlanGenerationActive)
            {
                isPlanning = true;
                _ = PollPlanAsync();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
            return;
        }
        catch (Exception exception) when (IsRequestFailure(exception))
        {
            error = exception.Message;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GeneratePlanAsync()
    {
        if (!TryGetChapterCount(out var chapterCount))
        {
            error = "Saisissez un nombre entier de 1 à 30 avant de créer le plan.";
            return;
        }

        if (chapters.Count > 0 &&
            !await ConfirmAsync("Recréer le plan remplacera les chapitres et leur contenu actuel. Cette action ne peut pas être annulée. Continuer ?",
                "Recréer le plan"))
        {
            return;
        }

        isPlanning = true;
        error = null;
        planError = null;
        try
        {
            ApplyPlan(await GenerationClient.GenerateBookPlanAsync(
                ProjectId,
                new GenerateBookPlanRequest(chapterCount),
                cancellation.Token),
                markSaved: true);
            if (isPlanGenerationActive)
            {
                await PollPlanAsync();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
            return;
        }
        catch (Exception exception) when (IsRequestFailure(exception))
        {
            planError = exception.Message;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            isPlanning = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        error = null;
        try
        {
            ApplyPlan(
                await GenerationClient.UpdateBookPlanAsync(ProjectId, CreateUpdateRequest(), cancellation.Token),
                markSaved: true);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
            return;
        }
        catch (Exception exception) when (IsRequestFailure(exception))
        {
            error = exception.Message;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task GenerateRemainingAsync()
    {
        isGenerating = true;
        error = null;
        try
        {
            ApplyPlan(
                await GenerationClient.UpdateBookPlanAsync(ProjectId, CreateUpdateRequest(), cancellation.Token),
                markSaved: true);

            foreach (var chapterId in chapters.Select(chapter => chapter.Id).ToArray())
            {
                var chapter = chapters.Single(item => item.Id == chapterId);
                if (chapter.ProseStatus != GenerationStatus.Completed)
                {
                    chapter.ProseError = null;
                    try
                    {
                        ApplyPlan(
                            await GenerationClient.GenerateChapterProseAsync(ProjectId, chapterId, cancellation.Token),
                            markSaved: true);
                    }
                    catch (AccessTokenNotAvailableException exception)
                    {
                        exception.Redirect();
                        return;
                    }
                    catch (Exception exception) when (IsRequestFailure(exception))
                    {
                        chapter.ProseError = exception.Message;
                        return;
                    }
                }

            }

            var imageIds = chapters
                .Where(chapter => chapter.ImageStatus != GenerationStatus.Completed)
                .Select(chapter => chapter.Id)
                .ToHashSet(StringComparer.Ordinal);
            if (imageIds.Count > 0)
            {
                foreach (var chapter in chapters.Where(chapter => imageIds.Contains(chapter.Id)))
                {
                    chapter.ImageStatus = GenerationStatus.Processing;
                    chapter.ImageError = null;
                    chapter.ImageLoadError = null;
                }

                var generationTask = GenerationClient.GenerateRemainingChapterImagesAsync(ProjectId, cancellation.Token);
                while (!generationTask.IsCompleted)
                {
                    var completed = await Task.WhenAny(
                        generationTask,
                        Task.Delay(TimeSpan.FromSeconds(1), cancellation.Token));
                    if (completed == generationTask)
                    {
                        break;
                    }

                    try
                    {
                        ApplyPlan(
                            await GenerationClient.GetBookPlanAsync(ProjectId, cancellation.Token),
                            markSaved: true);
                    }
                    catch (Exception exception) when (IsRequestFailure(exception))
                    {
                    }
                }

                ApplyPlan(
                    await generationTask,
                    markSaved: true,
                    refreshImageIds: imageIds);
                await PollActiveImagesAsync(imageIds);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception exception) when (IsRequestFailure(exception))
        {
            error = exception.Message;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task GenerateProseAsync(string chapterId)
    {
        var chapter = chapters.SingleOrDefault(item => item.Id == chapterId);
        if (chapter is null ||
            ((!string.IsNullOrWhiteSpace(chapter.Prose) || chapter.ProseStatus == GenerationStatus.Completed) &&
             !await ConfirmAsync("Le texte actuel sera remplacé par une nouvelle version. Continuer ?", "Réécrire le chapitre")))
        {
            return;
        }

        isGenerating = true;
        error = null;
        chapter.ProseError = null;
        try
        {
            ApplyPlan(
                await GenerationClient.UpdateBookPlanAsync(ProjectId, CreateUpdateRequest(), cancellation.Token),
                markSaved: true);
            ApplyPlan(
                await GenerationClient.GenerateChapterProseAsync(ProjectId, chapterId, cancellation.Token),
                markSaved: true);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception exception) when (IsRequestFailure(exception))
        {
            chapter.ProseError = exception.Message;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task GenerateImageAsync(string chapterId)
    {
        var chapter = chapters.SingleOrDefault(item => item.Id == chapterId);
        if (chapter is null ||
            ((chapter.ImageUri is not null || chapter.ImageStatus == GenerationStatus.Completed) &&
             !await ConfirmAsync("L’illustration actuelle sera remplacée. Continuer ?", "Recréer l’illustration")))
        {
            return;
        }

        isGenerating = true;
        error = null;
        chapter.ImageError = null;
        chapter.ImageLoadError = null;
        try
        {
            ApplyPlan(
                await GenerationClient.UpdateBookPlanAsync(ProjectId, CreateUpdateRequest(), cancellation.Token),
                markSaved: true);
            ApplyPlan(
                await GenerationClient.GenerateChapterImageAsync(ProjectId, chapterId, cancellation.Token),
                markSaved: true,
                refreshImageIds: [chapterId]);
            await PollActiveImagesAsync([chapterId]);
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception exception) when (IsRequestFailure(exception))
        {
            chapter.ImageError = exception.Message;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task<bool> ConfirmAsync(string message, string title)
    {
        return await DialogService.Confirm(
            message,
            title,
            new ConfirmOptions
            {
                OkButtonText = "Continuer",
                CancelButtonText = "Annuler",
                CloseDialogOnOverlayClick = false
            }) == true;
    }

    private async Task PollActiveImagesAsync(HashSet<string> chapterIds)
    {
        for (var attempt = 0;
             attempt < 240 && chapters.Any(chapter =>
                 chapterIds.Contains(chapter.Id) &&
                 chapter.ImageStatus == GenerationStatus.Processing);
             attempt++)
        {
            await Task.Delay(TimeSpan.FromSeconds(1), cancellation.Token);
            ApplyPlan(
                await GenerationClient.GetBookPlanAsync(ProjectId, cancellation.Token),
                markSaved: true);
        }
    }

    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (HasUnsavedChanges &&
            !await ConfirmAsync("Des modifications ne sont pas enregistrées. Les abandonner et quitter cette page ?",
                "Modifications non enregistrées"))
        {
            context.PreventNavigation();
        }
    }

    private void SelectChapter(string chapterId)
    {
        selectedChapterId = chapterId;
    }

    private void UpdateChapterCount(ChangeEventArgs args)
    {
        chapterCountText = args.Value?.ToString() ?? string.Empty;
    }

    private bool TryGetChapterCount(out int chapterCount) =>
        int.TryParse(chapterCountText, System.Globalization.NumberStyles.None,
            System.Globalization.CultureInfo.InvariantCulture, out chapterCount) &&
        chapterCount is >= 1 and <= 30;

    private UpdateBookPlanRequest CreateUpdateRequest() => new(chapters.Select(chapter => new BookChapterRequest(
        chapter.Id,
        chapter.Number,
        chapter.Title,
        chapter.Summary,
        chapter.CharacterEvents,
        chapter.Continuity,
        chapter.Prose,
        chapter.ImagePrompt)).ToArray());

    private void ApplyPlan(BookPlanResponse plan, bool markSaved = false, HashSet<string>? refreshImageIds = null)
    {
        isPlanGenerationActive = plan.IsGenerating;
        planError = plan.Error;

        var existingChapters = chapters.ToDictionary(chapter => chapter.Id, StringComparer.Ordinal);
        var updatedChapters = new List<ChapterDraft>(plan.Chapters.Count);
        foreach (var source in plan.Chapters)
        {
            if (existingChapters.TryGetValue(source.Id, out var existing))
            {
                var previousSaved = savedDrafts.GetValueOrDefault(source.Id);
                var current = ValuesOf(existing);
                var incoming = ValuesOf(source);
                var merged = markSaved
                    ? incoming
                    : MergeValues(current, incoming, previousSaved);

                var imageChanged = !Equals(existing.ImageUri, source.ImageUri) ||
                                   refreshImageIds?.Contains(source.Id) == true;
                existing.Title = merged.Title;
                existing.Summary = merged.Summary;
                existing.CharacterEvents = merged.CharacterEvents;
                existing.Continuity = merged.Continuity;
                existing.Prose = merged.Prose;
                existing.ImagePrompt = merged.ImagePrompt;
                existing.ProseStatus = source.ProseStatus;
                existing.ProseError = source.ProseError;
                existing.ImageStatus = source.ImageStatus;
                existing.ImageError = source.ImageError;
                existing.ImageUri = source.ImageUri;
                if (imageChanged)
                {
                    existing.ImageDataUrl = null;
                    existing.ImageLoadError = null;
                    existing.ImageLoadRevision++;
                }

                updatedChapters.Add(existing);
                if (markSaved)
                {
                    savedDrafts[source.Id] = ValuesOf(existing);
                }
                else
                {
                    savedDrafts[source.Id] = MergeSavedValues(current, incoming, previousSaved);
                }
            }
            else
            {
                var created = new ChapterDraft
                {
                    Id = source.Id,
                    Number = source.Number,
                    Title = source.Title,
                    Summary = source.Summary,
                    CharacterEvents = source.CharacterEvents,
                    Continuity = source.Continuity,
                    Prose = source.Prose,
                    ProseStatus = source.ProseStatus,
                    ProseError = source.ProseError,
                    ImagePrompt = source.ImagePrompt,
                    ImageStatus = source.ImageStatus,
                    ImageError = source.ImageError,
                    ImageUri = source.ImageUri
                };
                updatedChapters.Add(created);
                savedDrafts[source.Id] = ValuesOf(created);
            }
        }

        chapters.Clear();
        chapters.AddRange(updatedChapters);
        foreach (var staleId in savedDrafts.Keys.Except(chapters.Select(chapter => chapter.Id), StringComparer.Ordinal).ToArray())
        {
            savedDrafts.Remove(staleId);
        }

        if (chapters.Count > 0)
        {
            chapterCountText = chapters.Count.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (selectedChapterId is null || chapters.All(chapter => chapter.Id != selectedChapterId))
            {
                selectedChapterId = chapters[0].Id;
            }
        }
        else
        {
            selectedChapterId = null;
        }

        _ = LoadImagesAsync(plan);
    }

    private bool HasUnsavedChangesFor(ChapterDraft chapter)
    {
        return !savedDrafts.TryGetValue(chapter.Id, out var saved) || ValuesOf(chapter) != saved;
    }

    private static ChapterValues ValuesOf(ChapterDraft chapter) => new(
        chapter.Title,
        chapter.Summary,
        chapter.CharacterEvents,
        chapter.Continuity,
        chapter.Prose,
        chapter.ImagePrompt);

    private static ChapterValues ValuesOf(BookChapterResponse chapter) => new(
        chapter.Title,
        chapter.Summary,
        chapter.CharacterEvents,
        chapter.Continuity,
        chapter.Prose,
        chapter.ImagePrompt);

    private static ChapterValues MergeValues(ChapterValues current, ChapterValues incoming, ChapterValues? saved) => new(
        WasEdited(current.Title, saved?.Title, saved is not null) ? current.Title : incoming.Title,
        WasEdited(current.Summary, saved?.Summary, saved is not null) ? current.Summary : incoming.Summary,
        WasEdited(current.CharacterEvents, saved?.CharacterEvents, saved is not null) ? current.CharacterEvents : incoming.CharacterEvents,
        WasEdited(current.Continuity, saved?.Continuity, saved is not null) ? current.Continuity : incoming.Continuity,
        WasEdited(current.Prose, saved?.Prose, saved is not null) ? current.Prose : incoming.Prose,
        WasEdited(current.ImagePrompt, saved?.ImagePrompt, saved is not null) ? current.ImagePrompt : incoming.ImagePrompt);

    private static ChapterValues MergeSavedValues(ChapterValues current, ChapterValues incoming, ChapterValues? saved) => new(
        WasEdited(current.Title, saved?.Title, saved is not null) ? saved!.Title : incoming.Title,
        WasEdited(current.Summary, saved?.Summary, saved is not null) ? saved!.Summary : incoming.Summary,
        WasEdited(current.CharacterEvents, saved?.CharacterEvents, saved is not null) ? saved!.CharacterEvents : incoming.CharacterEvents,
        WasEdited(current.Continuity, saved?.Continuity, saved is not null) ? saved!.Continuity : incoming.Continuity,
        WasEdited(current.Prose, saved?.Prose, saved is not null) ? saved!.Prose : incoming.Prose,
        WasEdited(current.ImagePrompt, saved?.ImagePrompt, saved is not null) ? saved!.ImagePrompt : incoming.ImagePrompt);

    private static bool WasEdited(string? current, string? saved, bool hasSavedValue) =>
        hasSavedValue && !string.Equals(current, saved, StringComparison.Ordinal);

    private static string StatusLabel(GenerationStatus status) => status switch
    {
        GenerationStatus.Completed => "Prêt",
        GenerationStatus.Processing => "En cours",
        GenerationStatus.Failed => "À reprendre",
        _ => "À créer"
    };

    private static string StatusClass(GenerationStatus status) => status switch
    {
        GenerationStatus.Completed => "status ready",
        GenerationStatus.Processing => "status working",
        GenerationStatus.Failed => "status failed",
        _ => "status"
    };

    private async Task PollPlanAsync()
    {
        try
        {
            while (isPlanGenerationActive)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), cancellation.Token);
                var preserveDrafts = HasUnsavedChanges;
                ApplyPlan(
                    await GenerationClient.GetBookPlanAsync(ProjectId, cancellation.Token),
                    markSaved: !preserveDrafts);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (Exception exception) when (IsRequestFailure(exception))
        {
            error = exception.Message;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            isPlanning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadImagesAsync(BookPlanResponse plan)
    {
        foreach (var source in plan.Chapters.Where(chapter => chapter.ImageUri is not null))
        {
            var draft = chapters.SingleOrDefault(chapter => chapter.Id == source.Id);
            if (draft is null || draft.ImageDataUrl is not null || draft.ImageUri is null ||
                activeImageLoads.TryGetValue(draft.Id, out var activeRevision) &&
                activeRevision == draft.ImageLoadRevision)
            {
                continue;
            }

            var requestedUri = draft.ImageUri;
            var requestedRevision = draft.ImageLoadRevision;
            activeImageLoads[draft.Id] = requestedRevision;
            try
            {
                var dataUrl = await GenerationClient.DownloadDataUrlAsync(
                    AddImageCacheKey(requestedUri, requestedRevision),
                    cancellation.Token);
                var latest = chapters.SingleOrDefault(chapter => chapter.Id == draft.Id);
                if (latest is not null &&
                    latest.ImageLoadRevision == requestedRevision &&
                    Equals(latest.ImageUri, requestedUri))
                {
                    latest.ImageDataUrl = dataUrl;
                    latest.ImageLoadError = null;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (AccessTokenNotAvailableException exception)
            {
                exception.Redirect();
            }
            catch (Exception exception) when (IsRequestFailure(exception))
            {
                SetImageLoadError(draft.Id, requestedRevision, exception.Message);
            }
            catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
            {
            }
            finally
            {
                if (activeImageLoads.GetValueOrDefault(draft.Id) == requestedRevision)
                {
                    activeImageLoads.Remove(draft.Id);
                }
            }
        }
    }

    private bool IsRequestFailure(Exception exception) =>
        exception is GenerationApiException or HttpRequestException ||
        exception is OperationCanceledException && !cancellation.IsCancellationRequested;

    private static Uri AddImageCacheKey(Uri imageUri, int revision)
    {
        var original = imageUri.OriginalString;
        var separator = original.Contains('?') ? "&" : "?";
        return new Uri($"{original}{separator}bookImageRevision={revision}", imageUri.IsAbsoluteUri
            ? UriKind.Absolute
            : UriKind.Relative);
    }

    private void SetImageLoadError(string chapterId, int revision, string message)
    {
        var chapter = chapters.SingleOrDefault(item => item.Id == chapterId);
        if (chapter is not null && chapter.ImageLoadRevision == revision)
        {
            chapter.ImageLoadError = message;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }

    private sealed class ChapterDraft
    {
        public string Id { get; init; } = string.Empty;
        public int Number { get; init; }
        public string Title { get; set; } = string.Empty;
        public string Summary { get; set; } = string.Empty;
        public string CharacterEvents { get; set; } = string.Empty;
        public string Continuity { get; set; } = string.Empty;
        public string? Prose { get; set; }
        public GenerationStatus ProseStatus { get; set; }
        public string? ProseError { get; set; }
        public string? ImagePrompt { get; set; }
        public GenerationStatus ImageStatus { get; set; }
        public string? ImageError { get; set; }
        public string? ImageLoadError { get; set; }
        public Uri? ImageUri { get; set; }
        public string? ImageDataUrl { get; set; }
        public int ImageLoadRevision { get; set; }
    }

    private sealed record ChapterValues(
        string Title,
        string Summary,
        string CharacterEvents,
        string Continuity,
        string? Prose,
        string? ImagePrompt);
}
