@page "/projects"
@attribute [Authorize]
@implements IDisposable
@inject GenerationApiClient GenerationClient
@inject NavigationManager Navigation

<PageTitle>My projects</PageTitle>

<main class="projects-shell">
    <header class="projects-header">
        <div>
            <span class="eyebrow">Creative projects</span>
            <h1>My projects</h1>
            <p>Open a project to create and edit its boards.</p>
        </div>
        <button class="new-board" type="button" @onclick="ShowCreateProject">
            <RadzenIcon Icon="add" />
            New project
        </button>
    </header>

    @if (isCreating)
    {
        <section class="create-project" aria-label="Create project">
            <RadzenDropDown @bind-Value="newProjectType"
                            TValue="ProjectType"
                            Data="projectTypes"
                            Disabled="isSaving"
                            Style="width: 100%" />
            <RadzenTextBox @bind-Value="newProjectTitle"
                           Name="project-title"
                           Placeholder="Project title"
                           Disabled="isSaving"
                           Style="width: 100%" />
            @if (newProjectType == ProjectType.Book)
            {
                <RadzenTextArea @bind-Value="newProjectIdea"
                               Name="book-idea"
                               Placeholder="Summarize the book idea, characters, setting, tone, and key events..."
                               Rows="5"
                               Disabled="isSaving"
                               Style="width: 100%" />
            }
            <RadzenTextArea @bind-Value="newProjectContext"
                            Name="project-context"
                            Placeholder="Art direction (optional)"
                            Rows="3"
                            Disabled="isSaving"
                            Style="width: 100%" />
            <div class="create-project-actions">
                <RadzenButton Text="Cancel"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Outlined"
                              Disabled="isSaving"
                              Click="@CancelCreateProject" />
                <RadzenButton Text="Create project"
                              Icon="add"
                              IsBusy="isSaving"
                              Click="@CreateProjectAsync" />
            </div>
        </section>
    }

    @if (isLoading)
    {
        <div class="projects-state" role="status">
            <RadzenProgressBarCircular ShowValue="false" />
            <span>Loading projects…</span>
        </div>
    }
    else if (error is not null)
    {
        <div class="projects-state error" role="alert">@error</div>
    }
    else if (projects.Count == 0)
    {
        <section class="empty-projects">
            <RadzenIcon Icon="auto_stories" />
            <h2>Create your first comic project</h2>
            <p>Your projects and their boards will appear here.</p>
            <button class="new-board" type="button" @onclick="ShowCreateProject">New project</button>
        </section>
    }
    else
    {
        <section class="projects-grid" aria-label="Your projects">
            @foreach (var project in projects)
            {
                <a class="project-card" href="@ProjectUri(project)">
                    <div class="project-thumbnail">
                        <RadzenIcon Icon="auto_stories" />
                    </div>
                    <div class="project-details">
                        <span class="status">@project.Type</span>
                        <h2>@project.Title</h2>
                        <time datetime="@project.UpdatedAt.ToString("O")">Updated @project.UpdatedAt.ToLocalTime().ToString("d MMM yyyy")</time>
                    </div>
                </a>
            }
        </section>
    }
</main>

@code {
    private readonly CancellationTokenSource cancellation = new();
    private readonly List<ProjectResponse> projects = [];
    private readonly ProjectType[] projectTypes = Enum.GetValues<ProjectType>();
    private bool isLoading = true;
    private bool isCreating;
    private bool isSaving;
    private string newProjectTitle = string.Empty;
    private string? newProjectContext;
    private string? newProjectIdea;
    private ProjectType newProjectType;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            projects.AddRange(await GenerationClient.ListProjectsAsync(cancellation.Token));
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (GenerationApiException exception)
        {
            error = exception.Message;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateProject()
    {
        error = null;
        isCreating = true;
    }

    private void CancelCreateProject()
    {
        isCreating = false;
        newProjectTitle = string.Empty;
        newProjectContext = null;
        newProjectIdea = null;
        newProjectType = ProjectType.Comic;
    }

    private async Task CreateProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(newProjectTitle))
        {
            error = "Enter a project title.";
            return;
        }

        if (newProjectType == ProjectType.Book && string.IsNullOrWhiteSpace(newProjectIdea))
        {
            error = "Describe your book idea.";
            return;
        }

        isSaving = true;
        error = null;
        try
        {
            var project = await GenerationClient.CreateProjectAsync(
                new CreateProjectRequest(
                    newProjectTitle.Trim(),
                    newProjectContext?.Trim(),
                    newProjectType,
                    newProjectIdea?.Trim()),
                cancellation.Token);
            Navigation.NavigateTo(ProjectUri(project));
        }

        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
        catch (GenerationApiException exception)
        {
            error = exception.Message;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string ProjectUri(ProjectResponse project) => project.Type == ProjectType.Book
        ? $"/projects/{project.ProjectId:D}/book"
        : $"/projects/{project.ProjectId:D}";

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
