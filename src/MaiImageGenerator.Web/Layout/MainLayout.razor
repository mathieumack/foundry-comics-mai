@inherits LayoutComponentBase

<RadzenLayout class="app-layout">
	<RadzenHeader class="app-header">
		<div class="app-header-content">
			<div class="brand-block">
				<span class="brand-mark" aria-hidden="true">M</span>
				<div>
					<span class="eyebrow">Microsoft Foundry / image lab</span>
					<strong>MAI Studio</strong>
				</div>
			</div>
			<div class="connection-state">
				<span class="status-dot" aria-hidden="true"></span>
				Direct browser connection
			</div>
		</div>
	</RadzenHeader>
	<RadzenBody class="app-body">
		@Body
	</RadzenBody>
	<RadzenFooter class="app-footer">
		<span>MAI Studio</span>
		<span>Comic board workspace</span>
	</RadzenFooter>
</RadzenLayout>
<RadzenComponents />
