<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <RootNamespace>MaiImageGenerator.Shared</RootNamespace>
	  <AssemblyName>MaiImageGenerator.Shared</AssemblyName>
  </PropertyGroup>

<ItemGroup>
	<!-- EF Core with Cosmos DB provider -->
	<PackageReference Include="Microsoft.EntityFrameworkCore.Cosmos" Version="10.0.11" />
	<!-- Azure Storage -->
	<PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
	<PackageReference Include="Azure.Storage.Files.Shares" Version="12.27.1" />
	<!-- MDev SDK for Cosmos DB startup -->
	<PackageReference Include="MDev.Dotnet.Azure.CosmosDb" Version="1.18.0" />
	<!-- Service registration attribute -->
	<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
	<PackageReference Include="ServiceCollectionHelpers.AssemblyFinder" Version="1.8.0" />

	<!-- OpenTelemetry with Azure Monitor -->
	<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
	<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
	<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
	<PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.3" />
</ItemGroup>
</Project>
