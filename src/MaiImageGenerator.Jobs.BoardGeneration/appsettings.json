{
  "CosmosDb": {
    "Endpoint": "https://localhost:8081",
    "DatabaseName": "mai"
  },
  "OpenTelemetry": {
    "ServiceType": "AppInsights",
    "IgnoreErrorStatusCode": []
  },
  "ServiceBus": {
    "JobsQueueName": "generation-jobs"
  },
  "Foundry": {
    "MaxParallelImages": 3,
    "ImageRetryCount": 3,
    "ImageRetryBaseDelayMilliseconds": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}