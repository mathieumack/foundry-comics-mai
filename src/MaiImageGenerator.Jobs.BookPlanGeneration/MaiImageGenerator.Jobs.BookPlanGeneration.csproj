<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MaiImageGenerator.Jobs.BookPlanGeneration</RootNamespace>
    <AssemblyName>MaiImageGenerator.Jobs.BookPlanGeneration</AssemblyName>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <UserSecretsId>53d38eeb-1fa5-49cf-b953-aa76c6187f56</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.27.1" />
    <PackageReference Include="MDev.Dotnet.AspNetCore" Version="1.18.0" />
    <PackageReference Include="MDev.Dotnet.Azure.ContainerApps" Version="1.18.0" />
    <PackageReference Include="MDev.Dotnet.Azure.CosmosDb" Version="1.18.0" />
    <PackageReference Include="MDev.Dotnet.Azure.StorageAccount" Version="1.18.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.19.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="OpenAI" Version="2.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaiImageGenerator.Shared\MaiImageGenerator.Shared.csproj" />
  </ItemGroup>

</Project>
