{
  "type": "excalidraw",
  "version": 2,
  "source": "MAI Comic Studio",
  "appState": { "viewBackgroundColor": "#ffffff" },
  "elements": [
    { "type": "text", "id": "title", "x": 40, "y": 20, "width": 1080, "height": 70, "text": "MAI Comic Studio - application architecture", "fontSize": 28, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "type": "text", "id": "subtitle", "x": 40, "y": 80, "width": 1080, "height": 38, "text": "Educational exploration of Azure services and MAI models", "fontSize": 15, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "type": "rectangle", "id": "web", "x": 40, "y": 120, "width": 240, "height": 130, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "web-label" }] },
    { "type": "text", "id": "web-label", "containerId": "web", "x": 50, "y": 132, "width": 220, "height": 105, "text": "Blazor WebAssembly\nStatic Web Apps\nEntra sign-in", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "api", "x": 400, "y": 120, "width": 280, "height": 130, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "api-label" }] },
    { "type": "text", "id": "api-label", "containerId": "api", "x": 410, "y": 132, "width": 260, "height": 105, "text": ".NET API\nOwner validation / persistence\nForeground chapter stages", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "foundry", "x": 800, "y": 120, "width": 320, "height": 130, "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "foundry-label" }] },
    { "type": "text", "id": "foundry-label", "containerId": "foundry", "x": 810, "y": 132, "width": 300, "height": 105, "text": "Microsoft Foundry\nMAI-Thinking-1\nMAI-Image-2.5-Pro", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "signalr", "x": 40, "y": 400, "width": 240, "height": 130, "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "signalr-label" }] },
    { "type": "text", "id": "signalr-label", "containerId": "signalr", "x": 50, "y": 412, "width": 220, "height": 105, "text": "Dapr + Azure SignalR\nOwner-targeted progress\nDapr runs with API", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
