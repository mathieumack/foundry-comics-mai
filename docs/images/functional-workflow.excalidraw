{
  "type": "excalidraw",
  "version": 2,
  "source": "MAI Comic Studio",
  "appState": { "viewBackgroundColor": "#ffffff" },
  "elements": [
    { "type": "text", "id": "title", "x": 40, "y": 20, "width": 1080, "height": 70, "text": "MAI Comic Studio - functional workflow", "fontSize": 28, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "type": "text", "id": "subtitle", "x": 40, "y": 70, "width": 1080, "height": 38, "text": "Two creative journeys; private saved work and explicit human review", "fontSize": 15, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "type": "rectangle", "id": "library", "x": 40, "y": 130, "width": 240, "height": 160, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "library-label" }] },
    { "type": "text", "id": "library-label", "containerId": "library", "x": 50, "y": 150, "width": 220, "height": 105, "text": "Sign in\nPrivate story library\nCreate or reopen a project", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "story", "x": 400, "y": 130, "width": 280, "height": 160, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "story-label" }] },
    { "type": "text", "id": "story-label", "containerId": "story", "x": 410, "y": 150, "width": 260, "height": 105, "text": "Describe a story\nSet the creative direction\nChoose your creative format", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "format", "x": 800, "y": 130, "width": 320, "height": 160, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "format-label" }] },
    { "type": "text", "id": "format-label", "containerId": "format", "x": 810, "y": 150, "width": 300, "height": 105, "text": "Comic or illustrated book?\nPrepare the selected format\nNo automatic publication", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "comic", "x": 400, "y": 380, "width": 280, "height": 160, "strokeColor": "#F7630C", "backgroundColor": "#FFF4CE", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "comic-label" }] },
    { "type": "text", "id": "comic-label", "containerId": "comic", "x": 410, "y": 400, "width": 260, "height": 105, "text": "Prepare comic scenes\nLayout, prompts, characters\nSubmit a new board version", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "plan", "x": 800, "y": 380, "width": 320, "height": 160, "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "plan-label" }] },
    { "type": "text", "id": "plan-label", "containerId": "plan", "x": 810, "y": 400, "width": 300, "height": 105, "text": "Prepare a book plan\nBackground chapter planning\nReview and save chapter edits", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "panels", "x": 400, "y": 620, "width": 280, "height": 160, "strokeColor": "#F7630C", "backgroundColor": "#FFF4CE", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "panels-label" }] },
    { "type": "text", "id": "panels-label", "containerId": "panels", "x": 410, "y": 630, "width": 260, "height": 140, "text": "Background illustrations\nScenes update per image\nThumbnails update in place\nThen compose the final board", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "chapters", "x": 800, "y": 620, "width": 320, "height": 160, "strokeColor": "#107C10", "backgroundColor": "#DFF6DD", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "chapters-label" }] },
    { "type": "text", "id": "chapters-label", "containerId": "chapters", "x": 810, "y": 630, "width": 300, "height": 140, "text": "Work chapter by chapter\nGenerate prose or illustration\nKeep this editor open\nSave edits; retry stages", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "results", "x": 400, "y": 860, "width": 720, "height": 100, "strokeColor": "#0078D4", "backgroundColor": "#CFE4FA", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "results-label" }] },
    { "type": "text", "id": "results-label", "containerId": "results", "x": 410, "y": 875, "width": 700, "height": 70, "text": "Review saved results and any errors\nDownload available PNGs; reopen private projects later", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "rectangle", "id": "progress-note", "x": 40, "y": 380, "width": 280, "height": 400, "strokeColor": "#5C2D91", "backgroundColor": "#E8DAEF", "fillStyle": "solid", "strokeWidth": 2, "roundness": { "type": 3 }, "boundElements": [{ "type": "text", "id": "progress-label" }] },
    { "type": "text", "id": "progress-label", "containerId": "progress-note", "x": 55, "y": 390, "width": 250, "height": 385, "text": "Comic progress\nEach image appears before\nthe final board is ready.\nSelection stays unchanged.\nNo manual refresh needed.\nMissed live events?\nActive status refresh: 5 s.\nBackground work continues\nif the comic page closes.", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "type": "arrow", "id": "library-story", "x": 280, "y": 210, "width": 120, "height": 0, "strokeColor": "#495057", "strokeWidth": 2, "points": [[0, 0], [120, 0]], "endArrowhead": "arrow" },
    { "type": "arrow", "id": "story-format", "x": 680, "y": 210, "width": 120, "height": 0, "strokeColor": "#495057", "strokeWidth": 2, "points": [[0, 0], [120, 0]], "endArrowhead": "arrow" },
    { "type": "arrow", "id": "format-comic", "x": 900, "y": 290, "width": 360, "height": 90, "strokeColor": "#495057", "strokeWidth": 2, "points": [[0, 0], [0, 40], [-360, 40], [-360, 90]], "endArrowhead": "arrow" },
    { "type": "arrow", "id": "format-book", "x": 1020, "y": 290, "width": 0, "height": 90, "strokeColor": "#495057", "strokeWidth": 2, "points": [[0, 0], [0, 90]], "endArrowhead": "arrow" },
    { "type": "arrow", "id": "comic-panels", "x": 540, "y": 540, "width": 0, "height": 80, "strokeColor": "#495057", "strokeWidth": 2, "points": [[0, 0], [0, 80]], "endArrowhead": "arrow" },
    { "type": "arrow", "id": "plan-chapters", "x": 960, "y": 540, "width": 0, "height": 80, "strokeColor": "#495057", "strokeWidth": 2, "points": [[0, 0], [0, 80]], "endArrowhead": "arrow" },
    { "type": "arrow", "id": "panels-results", "x": 540, "y": 780, "width": 0, "height": 80, "strokeColor": "#495057", "strokeWidth": 2, "points": [[0, 0], [0, 80]], "endArrowhead": "arrow" },
    { "type": "arrow", "id": "chapters-results", "x": 960, "y": 780, "width": 0, "height": 80, "strokeColor": "#495057", "strokeWidth": 2, "points": [[0, 0], [0, 80]], "endArrowhead": "arrow" },
    { "type": "text", "id": "comic-edge", "x": 550, "y": 340, "width": 100, "height": 35, "text": "COMIC", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "type": "text", "id": "book-edge", "x": 1030, "y": 340, "width": 90, "height": 35, "text": "BOOK", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "type": "text", "id": "footer", "x": 40, "y": 968, "width": 1080, "height": 33, "text": "Completed boards can contain failed-panel placeholders. Inspect every image; no whole-book PDF/EPUB export is implemented.", "fontSize": 13, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" }
  ]
}
